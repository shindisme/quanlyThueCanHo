generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  password_hash String
  role          Role           @default(TENANT)
  status        UserStatus     @default(ACTIVE)
  created_at    DateTime       @default(now())
  notifications Notification[]
  staff         Staff?
  tenant        Tenant?

  @@map("users")
}

model Tenant {
  id                     Int                  @id @default(autoincrement())
  user_id                Int?                 @unique
  full_name              String
  phone                  String?              @unique
  email                  String?              @unique
  date_of_birth          DateTime?
  citizen_id             String               @unique
  address                String?
  is_verified            Boolean              @default(false)
  created_at             DateTime             @default(now())
  onboarding_building_id Int?
  invoices               Invoice[]
  maintenance            MaintenanceRequest[]
  occupants              Occupant[]
  contracts              RentalContract[]
  reservations           Reservation[]
  reviews                Review[]
  onboarding_building    Building?            @relation("TenantOnboardingBuilding", fields: [onboarding_building_id], references: [id])
  user                   User?                @relation(fields: [user_id], references: [id])

  @@index([created_at])
  @@index([onboarding_building_id])
  @@map("tenants")
}

model Occupant {
  id            Int       @id @default(autoincrement())
  tenant_id     Int
  full_name     String
  phone         String?
  citizen_id    String
  date_of_birth DateTime?
  created_at    DateTime  @default(now())
  tenant        Tenant    @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@map("occupants")
}

model Building {
  id                 Int            @id @default(autoincrement())
  branch_name        String
  description        String?
  status             BuildingStatus @default(ACTIVE)
  total_floors       Int
  total_apartments   Int            @default(0)
  thumbnail_url      String?
  created_at         DateTime       @default(now())
  address            String
  apartments         Apartment[]
  assigned_staff     Staff[]        @relation("BuildingStaff")
  onboarding_tenants Tenant[]       @relation("TenantOnboardingBuilding")

  @@index([status])
  @@index([created_at])
  @@map("buildings")
}

model Staff {
  id                   Int                  @id @default(autoincrement())
  user_id              Int?                 @unique
  building_id          Int?
  full_name            String
  phone                String?              @unique
  position             String
  created_at           DateTime             @default(now())
  maintenance_requests MaintenanceRequest[] @relation("MaintenanceTechnician")
  building             Building?            @relation("BuildingStaff", fields: [building_id], references: [id])
  user                 User?                @relation(fields: [user_id], references: [id])
  UtilityReading       UtilityReading[]

  @@index([building_id])
  @@map("staffs")
}

model Apartment {
  id           Int                  @id @default(autoincrement())
  building_id  Int
  description  String?
  area         Decimal              @db.Decimal(10, 2)
  bedrooms     Int
  bathrooms    Int
  rental_price Decimal              @db.Decimal(12, 2)
  status       ApartmentStatus      @default(AVAILABLE)
  floor        Int
  room_number  String
  images       ApartmentImage[]
  building     Building             @relation(fields: [building_id], references: [id])
  maintenance  MaintenanceRequest[]
  contracts    RentalContract[]
  reservations Reservation[]
  reviews      Review[]
  utilities    UtilityReading[]
  viewings     ViewingSchedule[]

  @@unique([building_id, floor, room_number])
  @@index([building_id])
  @@index([status])
  @@index([building_id, status])
  @@index([building_id, floor])
  @@map("apartments")
}

model ApartmentImage {
  id           Int       @id @default(autoincrement())
  apartment_id Int
  image_url    String
  is_thumbnail Boolean   @default(false)
  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@index([apartment_id])
  @@index([apartment_id, is_thumbnail])
  @@map("apartment_images")
}

model RentalContract {
  id             Int                   @id @default(autoincrement())
  apartment_id   Int
  tenant_id      Int
  start_date     DateTime
  end_date       DateTime
  deposit_amount Decimal               @db.Decimal(12, 2)
  monthly_rent   Decimal               @db.Decimal(12, 2)
  status         ContractStatus        @default(ACTIVE)
  contract_file  String?
  signed_at      DateTime
  created_at     DateTime              @default(now())
  extended_at    DateTime?
  invoices       Invoice[]
  terminations   ContractTermination[]
  apartment      Apartment             @relation(fields: [apartment_id], references: [id])
  tenant         Tenant                @relation(fields: [tenant_id], references: [id])
  reservation    Reservation?

  @@index([apartment_id, status])
  @@index([tenant_id, status])
  @@index([status, end_date])
  @@map("rental_contracts")
}

model Invoice {
  id               Int                 @id @default(autoincrement())
  contract_id      Int?
  tenant_id        Int
  invoice_code     String              @unique
  due_date         DateTime
  total_amount     Decimal             @db.Decimal(12, 2)
  status           InvoiceStatus       @default(UNPAID)
  created_at       DateTime            @default(now())
  paid_at          DateTime?
  reservation_id   Int?
  type             InvoiceType         @default(MONTHLY)
  items            InvoiceItem[]
  final_settlement ContractSettlement? @relation("SettlementFinalInvoice")
  contract         RentalContract?     @relation(fields: [contract_id], references: [id])
  reservation      Reservation?        @relation(fields: [reservation_id], references: [id])
  tenant           Tenant              @relation(fields: [tenant_id], references: [id])
  payments         Payment[]

  @@index([contract_id])
  @@index([reservation_id])
  @@index([type])
  @@index([tenant_id, status])
  @@index([status, due_date])
  @@index([created_at])
  @@map("invoices")
}

model Reservation {
  id             Int               @id @default(autoincrement())
  apartment_id   Int
  tenant_id      Int
  contract_id    Int?              @unique
  deposit_amount Decimal           @db.Decimal(12, 2)
  reserved_at    DateTime          @default(now())
  expires_at     DateTime
  status         ReservationStatus @default(ACTIVE)
  created_at     DateTime          @default(now())
  invoices       Invoice[]
  apartment      Apartment         @relation(fields: [apartment_id], references: [id])
  contract       RentalContract?   @relation(fields: [contract_id], references: [id])
  tenant         Tenant            @relation(fields: [tenant_id], references: [id])

  @@index([apartment_id, status])
  @@index([tenant_id, status])
  @@index([expires_at, status])
  @@map("reservations")
}

model InvoiceItem {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  item_name  String
  quantity   Decimal @db.Decimal(10, 2)
  unit_price Decimal @db.Decimal(12, 2)
  amount     Decimal @db.Decimal(12, 2)
  invoice    Invoice @relation(fields: [invoice_id], references: [id])

  @@index([invoice_id])
  @@map("invoice_items")
}

model Payment {
  id               Int           @id @default(autoincrement())
  invoice_id       Int
  payment_method   String
  transaction_code String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  paid_at          DateTime?
  invoice          Invoice       @relation(fields: [invoice_id], references: [id])

  @@index([invoice_id, status])
  @@index([paid_at])
  @@map("payments")
}

model MaintenanceRequest {
  id                Int           @id @default(autoincrement())
  tenant_id         Int
  apartment_id      Int
  title             String
  description       String
  image_url         String?
  priority          Priority      @default(MEDIUM)
  status            RequestStatus @default(PENDING)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  assigned_staff_id Int?
  scheduled_at      DateTime?
  unable_reason     String?
  apartment         Apartment     @relation(fields: [apartment_id], references: [id])
  assigned_staff    Staff?        @relation("MaintenanceTechnician", fields: [assigned_staff_id], references: [id])
  tenant            Tenant        @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([apartment_id])
  @@index([status, created_at])
  @@index([assigned_staff_id, status])
  @@map("maintenance_requests")
}

model ContractTermination {
  id                    Int                         @id @default(autoincrement())
  contract_id           Int
  type                  ContractTerminationType
  status                ContractTerminationStatus   @default(PENDING)
  requested_end_date    DateTime
  effective_end_date    DateTime?
  reason                String?
  notice_days           Int
  deposit_policy        DepositPolicy
  refund_rate           Decimal                     @db.Decimal(5, 2)
  requested_by          Int?
  requested_at          DateTime                    @default(now())
  approved_by           Int?
  approved_at           DateTime?
  rejected_reason       String?
  completed_at          DateTime?
  completed_by          Int?
  inspection_note       String?
  final_electricity_old Decimal?                    @db.Decimal(10, 2)
  final_electricity_new Decimal?                    @db.Decimal(10, 2)
  final_water_old       Decimal?                    @db.Decimal(10, 2)
  final_water_new       Decimal?                    @db.Decimal(10, 2)
  requires_maintenance  Boolean                     @default(false)
  created_at            DateTime                    @default(now())
  updated_at            DateTime                    @updatedAt
  contract              RentalContract              @relation(fields: [contract_id], references: [id])
  damages               ContractTerminationDamage[]
  settlement            ContractSettlement?

  @@index([contract_id, status])
  @@index([status, requested_at])
  @@map("contract_terminations")
}

model ContractTerminationDamage {
  id             Int                 @id @default(autoincrement())
  termination_id Int
  description    String
  amount         Decimal             @db.Decimal(12, 2)
  note           String?
  created_at     DateTime            @default(now())
  termination    ContractTermination @relation(fields: [termination_id], references: [id], onDelete: Cascade)

  @@index([termination_id])
  @@map("contract_termination_damages")
}

model ContractSettlement {
  id                    Int                       @id @default(autoincrement())
  termination_id        Int                       @unique
  final_invoice_id      Int?                      @unique
  deposit_paid          Decimal                   @db.Decimal(12, 2)
  eligible_deposit      Decimal                   @db.Decimal(12, 2)
  outstanding_debt      Decimal                   @db.Decimal(12, 2)
  final_rent            Decimal                   @db.Decimal(12, 2)
  final_electricity     Decimal                   @db.Decimal(12, 2)
  final_water           Decimal                   @db.Decimal(12, 2)
  final_service_fee     Decimal                   @db.Decimal(12, 2)
  other_charges         Decimal                   @db.Decimal(12, 2)
  damage_amount         Decimal                   @db.Decimal(12, 2)
  deposit_applied       Decimal                   @db.Decimal(12, 2)
  refund_amount         Decimal                   @db.Decimal(12, 2)
  additional_amount_due Decimal                   @db.Decimal(12, 2)
  financial_status      SettlementFinancialStatus @default(PENDING)
  calculated_at         DateTime                  @default(now())
  settled_at            DateTime?
  created_at            DateTime                  @default(now())
  updated_at            DateTime                  @updatedAt
  termination           ContractTermination       @relation(fields: [termination_id], references: [id], onDelete: Cascade)
  final_invoice         Invoice?                  @relation("SettlementFinalInvoice", fields: [final_invoice_id], references: [id])

  @@index([financial_status])
  @@map("contract_settlements")
}

model ViewingSchedule {
  id                Int            @id @default(autoincrement())
  apartment_id      Int
  guest_name        String
  guest_phone       String
  guest_email       String?
  schedule_time     DateTime
  status            ScheduleStatus @default(PENDING)
  created_at        DateTime       @default(now())
  temp_locked_until DateTime?
  apartment         Apartment      @relation(fields: [apartment_id], references: [id])

  @@index([apartment_id])
  @@index([status, schedule_time])
  @@index([temp_locked_until])
  @@map("viewing_schedules")
}

model UtilityReading {
  id           Int       @id @default(autoincrement())
  apartment_id Int
  month        Int
  year         Int
  electric_old Decimal   @db.Decimal(10, 2)
  electric_new Decimal   @db.Decimal(10, 2)
  water_old    Decimal   @db.Decimal(10, 2)
  water_new    Decimal   @db.Decimal(10, 2)
  created_at   DateTime  @default(now())
  recorded_by  Int
  apartment    Apartment @relation(fields: [apartment_id], references: [id])
  staff        Staff     @relation(fields: [recorded_by], references: [id])

  @@unique([apartment_id, month, year])
  @@index([apartment_id, month, year])
  @@index([recorded_by])
  @@map("utility_readings")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  content    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])

  @@index([user_id, is_read, created_at])
  @@index([type])
  @@map("notifications")
}

model Review {
  id           Int       @id @default(autoincrement())
  apartment_id Int
  tenant_id    Int
  rating       Int
  comment      String?
  created_at   DateTime  @default(now())
  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  tenant       Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@unique([apartment_id, tenant_id])
  @@index([apartment_id])
  @@index([tenant_id])
  @@map("reviews")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  TENANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
}

enum ApartmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RESERVED
  VACATING_SOON
}

enum ContractStatus {
  ACTIVE
  ENDED
}

enum InvoiceStatus {
  PAID
  UNPAID
}

enum InvoiceType {
  DEPOSIT
  FIRST_RENT
  MONTHLY
  MAINTENANCE
  FINAL_SETTLEMENT
}

enum ContractTerminationType {
  TENANT_REQUEST
  OVERDUE
}

enum ContractTerminationStatus {
  PENDING
  APPROVED
  REJECTED
  INSPECTION
  SETTLING
  COMPLETED
  CANCELLED
}

enum DepositPolicy {
  REFUNDABLE
  FORFEITED
}

enum SettlementFinancialStatus {
  PENDING
  AWAITING_PAYMENT
  PARTIALLY_PAID
  SETTLED
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  FORFEITED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  PROCESSING
  DONE
  NEEDS_RESCHEDULE
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}
