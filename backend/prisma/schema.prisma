generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  TENANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum BuildingStatus {
  ACTIVE
  INACTIVE
}

enum ApartmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum ContractStatus {
  ACTIVE
  ENDED
}

enum InvoiceStatus {
  PAID
  UNPAID
}

enum PaymentStatus {
  SUCCESS
  PENDING
  FAILED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  PROCESSING
  DONE
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  phone         String?    @unique
  password_hash String
  role          Role       @default(TENANT)
  status        UserStatus @default(ACTIVE)
  created_at    DateTime   @default(now())

  tenant        Tenant?
  notifications Notification[]
  chat_sessions ChatConversation[]
  @@map("users")
}

model Tenant {
  id            Int      @id @default(autoincrement())
  user_id       Int      @unique
  full_name     String
  date_of_birth DateTime?
  citizen_id    String   @unique
  address       String?
  is_verified   Boolean  @default(false)
  created_at    DateTime @default(now())

  user          User     @relation(fields: [user_id], references: [id])
  contracts     RentalContract[]
  maintenance   MaintenanceRequest[]
  @@map("tenants")
}

model Building {
  id               Int            @id @default(autoincrement())
  name             String
  address_old      String        
  address_new      String
  description      String?        @db.Text
  status           BuildingStatus @default(ACTIVE)
  total_floors     Int
  total_apartments Int            @default(0)
  thumbnail_url    String?
  branch_name      String
  created_at       DateTime       @default(now())
  
  apartments       Apartment[]
  @@map("buildings")
}

model Apartment {
  id           Int             @id @default(autoincrement())
  building_id  Int
  description  String?         @db.Text
  area         Decimal         @db.Decimal(10, 2)
  bedrooms     Int
  bathrooms    Int
  rental_price Decimal         @db.Decimal(12, 2)
  status       ApartmentStatus @default(AVAILABLE)
  floor        Int
  room_number  String
  
  building     Building        @relation(fields: [building_id], references: [id])
  images       ApartmentImage[]
  contracts    RentalContract[]
  maintenance  MaintenanceRequest[]
  viewings     ViewingSchedule[]
  utilities    UtilityReading[]
  @@map("apartments")
}

model ApartmentImage {
  id           Int       @id @default(autoincrement())
  apartment_id Int
  image_url    String
  is_thumbnail Boolean   @default(false)
  apartment    Apartment @relation(fields: [apartment_id], references: [id])
  @@map("apartment_images")
}

model RentalContract {
  id             Int            @id @default(autoincrement())
  apartment_id   Int
  tenant_id      Int
  start_date     DateTime
  end_date       DateTime
  deposit_amount Decimal        @db.Decimal(12, 2)
  monthly_rent   Decimal        @db.Decimal(12, 2)
  status         ContractStatus @default(ACTIVE)
  contract_file  String?
  signed_at      DateTime
  created_at     DateTime       @default(now())

  apartment      Apartment      @relation(fields: [apartment_id], references: [id])
  tenant         Tenant         @relation(fields: [tenant_id], references: [id])
  invoices       Invoice[]
  @@map("rental_contracts")
}

model Invoice {
  id           Int           @id @default(autoincrement())
  contract_id  Int
  tenant_id    Int
  invoice_code String        @unique
  due_date     DateTime
  total_amount Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(UNPAID)
  created_at   DateTime      @default(now())
  paid_at      DateTime?

  contract     RentalContract @relation(fields: [contract_id], references: [id])
  items        InvoiceItem[]
  payments     Payment[]
  @@map("invoices")
}

model InvoiceItem {
  id         Int     @id @default(autoincrement())
  invoice_id Int
  item_name  String
  quantity   Decimal @db.Decimal(10, 2)
  unit_price Decimal @db.Decimal(12, 2)
  amount     Decimal @db.Decimal(12, 2)
  invoice    Invoice @relation(fields: [invoice_id], references: [id])
  @@map("invoice_items")
}

model Payment {
  id               Int           @id @default(autoincrement())
  invoice_id       Int
  payment_method   String
  transaction_code String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  paid_at          DateTime      @default(now())

  invoice          Invoice       @relation(fields: [invoice_id], references: [id])
  @@map("payments")
}

model MaintenanceRequest {
  id           Int           @id @default(autoincrement())
  tenant_id    Int
  apartment_id Int
  title        String
  description  String        @db.Text
  image_url    String?
  priority     Priority      @default(MEDIUM)
  status       RequestStatus @default(PENDING)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenant_id], references: [id])
  apartment    Apartment     @relation(fields: [apartment_id], references: [id])
  @@map("maintenance_requests")
}

model ViewingSchedule {
  id            Int            @id @default(autoincrement())
  apartment_id  Int
  guest_name    String
  guest_phone   String
  guest_email   String?
  schedule_time DateTime
  status        ScheduleStatus @default(PENDING)
  created_at    DateTime       @default(now())

  apartment     Apartment      @relation(fields: [apartment_id], references: [id])
  temp_locked_until DateTime?
  @@map("viewing_schedules")
}

model UtilityReading {
  id           Int       @id @default(autoincrement())
  apartment_id Int
  month        Int
  year         Int
  electric_old Decimal   @db.Decimal(10, 2)
  electric_new Decimal   @db.Decimal(10, 2)
  water_old    Decimal   @db.Decimal(10, 2)
  water_new    Decimal   @db.Decimal(10, 2)
  created_at   DateTime  @default(now())
  recorded_by  Int

  apartment    Apartment @relation(fields: [apartment_id], references: [id])
  @@map("utility_readings")
}

model Notification {
  id         Int      @id @default(autoincrement())
  user_id    Int
  title      String
  content    String   @db.Text
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  @@map("notifications")
}

model ChatConversation {
  id         Int      @id @default(autoincrement())
  user_id    Int
  created_at DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  messages   ChatbotMessage[]
  @@map("chat_conversations")
}

model ChatbotMessage {
  id              Int              @id @default(autoincrement())
  conversation_id Int
  message         String           @db.Text
  sender_type     String
  created_at      DateTime         @default(now())
  conversation    ChatConversation @relation(fields: [conversation_id], references: [id])
  @@map("chatbot_messages")
}