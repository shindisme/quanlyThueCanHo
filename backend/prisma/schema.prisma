generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  TENANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum BuildingStatus {
  ACTIVE
  MAINTENANCE
}

enum ApartmentStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
}

enum ContractStatus {
  ACTIVE
  ENDED
  LIQUIDATED
}

enum InvoiceStatus {
  PAID
  UNPAID
  OVERDUE
}

enum PaymentMethod {
  BANK_TRANSFER
  MOMO
  VNPAY
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum RequestStatus {
  PENDING
  PROCESSING
  DONE
  CANCELLED
}

enum ScheduleStatus {
  PENDING
  CONFIRMED
  DONE
  CANCELLED
}

enum NotificationType {
  SYSTEM
  INVOICE
  MAINTENANCE
  CHAT
}

enum SenderType {
  USER
  CHATBOT
}

model User {
  id            Int        @id @default(autoincrement())
  email         String     @unique
  phone         String?    @unique
  password_hash String
  role          Role       @default(TENANT)
  status        UserStatus @default(ACTIVE)
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  tenant_profile Tenant?
  notifications  Notification[]
  chat_sessions  ChatSession[]

  @@map("users")
}

model Tenant {
  id            Int       @id @default(autoincrement())
  user_id       Int?      @unique
  full_name     String
  citizen_id    String    @unique
  date_of_birth DateTime?
  address       String?
  is_verified   Boolean   @default(false)
  created_at    DateTime  @default(now())

  user          User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  contracts            RentalContract[]
  invoices             Invoice[]
  maintenance_requests MaintenanceRequest[]

  @@map("tenants")
}

model Building {
  id              Int            @id @default(autoincrement())
  name            String
  address         String
  description     String?        @db.Text
  status          Int            @default(1)
  totalFloors     Int            @map("total_floors")
  branchName      String         @map("branch_name")
  totalApartments Int            @default(0) @map("total_apartments")
  thumbnailUrl    String?        @map("thumbnail_url")
  createdAt       DateTime       @default(now()) @map("created_at")
  
  apartments      Apartment[]

  @@map("buildings")
}

model Apartment {
  id             Int             @id @default(autoincrement())
  building_id    Int
  apartment_code String
  title          String
  description    String?         @db.Text
  area           Decimal         @db.Decimal(10, 2)
  rental_price   Decimal         @db.Decimal(12, 2)
  status         ApartmentStatus @default(AVAILABLE)
  created_at     DateTime        @default(now())

  building       Building          @relation(fields: [building_id], references: [id], onDelete: Cascade)
  images         ApartmentImage[]
  contracts      RentalContract[]
  utility_readings UtilityReading[]
  viewing_schedules ViewingSchedule[]
  maintenance_requests MaintenanceRequest[]

  @@index([building_id])
  @@map("apartments")
}

model ApartmentImage {
  id           Int       @id @default(autoincrement())
  apartment_id Int
  image_url    String
  is_thumbnail Boolean   @default(false)
  created_at   DateTime  @default(now())

  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@index([apartment_id])
  @@map("apartment_images")
}

model RentalContract {
  id             Int            @id @default(autoincrement())
  apartment_id   Int
  tenant_id      Int
  start_date     DateTime
  end_date       DateTime
  deposit_amount Decimal        @db.Decimal(12, 2)
  monthly_rent   Decimal        @db.Decimal(12, 2)
  status         ContractStatus @default(ACTIVE)
  contractFile   String?        @map("contract_file")
  signedAt       DateTime       @map("signed_at")
  createdBy      Int            @map("created_by")
  created_at     DateTime       @default(now())

  apartment      Apartment      @relation(fields: [apartment_id], references: [id], onDelete: Restrict)
  tenant         Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  invoices       Invoice[]

  @@index([apartment_id])
  @@index([tenant_id])
  @@map("rental_contracts")
}

model Invoice {
  id           Int           @id @default(autoincrement())
  invoice_code String        @unique
  contract_id  Int
  tenant_id    Int
  due_date     DateTime
  total_amount Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(UNPAID)
  paid_at      DateTime?
  created_at   DateTime      @default(now())

  contract        RentalContract @relation(fields: [contract_id], references: [id], onDelete: Restrict)
  tenant          Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  items           InvoiceItem[]
  payments        Payment[]
  utility_reading UtilityReading?

  @@index([contract_id])
  @@index([tenant_id])
  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoice_id  Int
  item_name   String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unit_price  Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  description String?

  invoice     Invoice @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@map("invoice_items")
}

model Payment {
  id               Int           @id @default(autoincrement())
  invoice_id       Int
  payment_method   PaymentMethod
  transaction_code String?       @unique
  amount           Decimal       @db.Decimal(12, 2)
  status           PaymentStatus @default(PENDING)
  paid_at          DateTime      @default(now())

  invoice          Invoice       @relation(fields: [invoice_id], references: [id], onDelete: Restrict)

  @@index([invoice_id])
  @@map("payments")
}

model UtilityReading {
  id           Int      @id @default(autoincrement())
  apartment_id Int
  invoice_id   Int?     @unique
  month        Int
  year         Int
  electric_old Decimal  @db.Decimal(10, 2)
  electric_new Decimal  @db.Decimal(10, 2)
  water_old    Decimal  @db.Decimal(10, 2)
  water_new    Decimal  @db.Decimal(10, 2)
  image_url    String?
  recorded_by  Int
  created_at   DateTime @default(now())

  apartment    Apartment @relation(fields: [apartment_id], references: [id], onDelete: Cascade)
  invoice      Invoice?  @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@index([apartment_id])
  @@map("utility_readings")
}

model MaintenanceRequest {
  id           Int           @id @default(autoincrement())
  tenant_id    Int
  apartment_id Int
  title        String
  description  String        @db.Text
  image_url    String?
  priority     Priority      @default(MEDIUM)
  status       RequestStatus @default(PENDING)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  apartment    Apartment     @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([apartment_id])
  @@map("maintenance_requests")
}

model ViewingSchedule {
  id            Int            @id @default(autoincrement())
  apartment_id  Int
  guest_name    String
  guest_phone   String
  guest_email   String?
  schedule_time DateTime
  status        ScheduleStatus @default(PENDING)
  created_at    DateTime       @default(now())

  apartment     Apartment      @relation(fields: [apartment_id], references: [id], onDelete: Cascade)

  @@index([apartment_id])
  @@map("viewing_schedules")
}

model Notification {
  id         Int              @id @default(autoincrement())
  user_id    Int
  title      String
  content    String           @db.Text
  type       NotificationType
  is_read    Boolean          @default(false)
  created_at DateTime         @default(now())

  user       User             @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("notifications")
}

model ChatSession {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  created_at DateTime @default(now())

  user       User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  messages   ChatbotMessage[]

  @@index([user_id])
  @@map("chat_sessions")
}

model ChatbotMessage {
  id              Int         @id @default(autoincrement())
  conversation_id Int
  message         String      @db.Text
  sender_type     SenderType
  created_at      DateTime    @default(now())

  session         ChatSession @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id])
  @@map("chatbot_messages")
}